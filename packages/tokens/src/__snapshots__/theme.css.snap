/* Generated by @tessera/tokens from tokens/*.json. Do not edit by hand: run `pnpm --filter @tessera/tokens tokens`. */
/* Tailwind v4 theme: semantic and component tokens only. Primitives are never exposed. */

@import "./tokens.css";

/* Remove Tailwind's default palette and scales in every namespace Tessera owns. */
@theme {
  --color-*: initial;
  --spacing: initial;
  --spacing-*: initial;
  --radius-*: initial;
  --font-*: initial;
  --font-weight-*: initial;
  --text-*: initial;
  --leading-*: initial;
  --tracking-*: initial;
  --shadow-*: initial;
  --inset-shadow-*: initial;
  --drop-shadow-*: initial;
  --text-shadow-*: initial;
}

/* inline: utilities read the runtime var directly, so [data-theme] switches them. */
@theme inline {
  --color-bg: var(--tsr-color-bg);
  --color-surface: var(--tsr-color-surface);
  --color-surface-raised: var(--tsr-color-surface-raised);
  --color-surface-sunken: var(--tsr-color-surface-sunken);
