{
  "primitive": {
    "font-family": {
      "$type": "fontFamily",
      "inter": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"]
      },
      "jetbrains-mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"]
      }
    },
    "font-size": {
      "$type": "dimension",
      "12": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "14": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "16": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "18": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "20": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "24": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "30": {
        "$value": {
          "value": 1.875,
          "unit": "rem"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "snug": {
        "$value": 1.375
      },
      "normal": {
        "$value": 1.5
      }
    },
    "font-weight": {
      "$type": "fontWeight",
      "400": {
        "$value": 400
      },
      "500": {
        "$value": 500
      },
      "600": {
        "$value": 600
      }
    }
  }
}
