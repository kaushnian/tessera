{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm format)",
      "Bash(pnpm turbo run *)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm exec biome check *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec tsc --noEmit*)",
      "Bash(pnpm list *)",
      "Bash(pnpm why *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Bash(pnpm publish*)",
      "Bash(pnpm changeset publish*)",
      "Bash(pnpm exec changeset publish*)",
      "Bash(npm publish*)"
    ]
  }
}
